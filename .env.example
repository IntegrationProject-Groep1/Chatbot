# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Get a free key at https://integrate.api.nvidia.com/ → "Get API Key"
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# Production credentials: ask infra / check the RabbitMQ secret in the k8s
# namespace (kubectl get secret rabbitmq-credentials -n <ns> -o yaml)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBIT_USER=guest
RABBIT_PASS=guest
RABBITMQ_VHOST=/

IDENTITY_RPC_QUEUE=identity.user.lookup.email.request
RPC_TIMEOUT=10.0

# ── Session store ─────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=3600

# ── MCP server URLs ───────────────────────────────────────────────────────────
# Comma-separated label@url pairs. Unknown/unreachable servers are skipped at
# startup with a warning — the chatbot starts fine without them.
#
# sessions  → our team, runs on port 8001 (this repo)
# monitoring → our team, runs on port 8005 (this repo)
# facturatie → MISSING: facturatie team needs to build their MCP server
#              (see docs/mcp-server-guide.md for a one-file example)
# crm        → MISSING: CRM team needs to build their MCP server
# kassa      → MISSING: Kassa team needs to build their MCP server
#
# For local dev: run both our servers first
#   python -m src.mcp_servers.sessions
#   python -m src.mcp_servers.monitoring
MCP_SERVERS=sessions@http://localhost:8001/mcp,monitoring@http://localhost:8005/mcp

# ── Sessions MCP — Drupal JSON:API ───────────────────────────────────────────
# Production: Drupal frontend runs at desiderius.me
# Local dev:  http://localhost:30020
FRONTEND_BASE_URL=https://desiderius.me

# ── Monitoring MCP — Elasticsearch ───────────────────────────────────────────
# NOTE: kibana.desiderius.me is the Kibana *UI*, not the ES REST API.
# We need the Elasticsearch endpoint directly (port 9200).
# Inside the cluster it is likely something like:
#   http://elasticsearch-master.monitoring.svc.cluster.local:9200
# To find it:
#   kubectl get svc -n monitoring | grep elasticsearch
# If ES requires auth (X-Pack):
#   ES_USERNAME=elastic
#   ES_PASSWORD=<from: kubectl get secret elasticsearch-credentials -n monitoring -o yaml>
#
# Production (fill in once you have the internal cluster DNS):
ELASTICSEARCH_URL=http://localhost:9200
# ES_USERNAME=
# ES_PASSWORD=

# Index names — confirm with infra/monitoring team what Logstash writes to
ES_LOGS_INDEX=logs
ES_HEARTBEAT_INDEX=heartbeats

# ── Other teams' backends (for reference — NOT used by our code directly) ─────
# These are the backend apps. Each team builds a small MCP server on top.
# Once they do, add label@url to MCP_SERVERS above.
#
# Facturatie (FossBilling): https://facturatie.desiderius.me
# Kassa (Odoo):             https://kassa.desiderius.me
# CRM (Salesforce):         ask CRM team for their Salesforce org URL
