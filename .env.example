# ==========================================
# CORE INFRASTRUCTURE
# ==========================================
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_ERLANG_COOKIE=
 
# External database port (default: 30004)
EXTERNAL_DB_PORT=30004
 
# Shared PostgreSQL (pgadmin + identity)
DB_USER=
DB_PASSWORD=
DB_NAME=
 
# pgAdmin
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
 
# Teams Webhook URLs (get from PM)
TEAMS_WEBHOOK_INFRA=
TEAMS_WEBHOOK_FRONTEND=
TEAMS_WEBHOOK_KASSA=
TEAMS_WEBHOOK_CRM=
TEAMS_WEBHOOK_PLANNING=
TEAMS_WEBHOOK_FACTURATIE=
TEAMS_WEBHOOK_MONITORING=
 
# ==========================================
# TEAM FRONTEND (DRUPAL)
# ==========================================
DRUPAL_DB_ROOT_PASS=
DRUPAL_DB_NAME=drupal
DRUPAL_DB_USER=drupal_user
DRUPAL_DB_PASS=
DRUPAL_BASE_URL=
RABBITMQFRONTEND_USER=
RABBITMQFRONTEND_PASS=
 
# ==========================================
# MONITORING (ELK)
# ==========================================
ES_ADMIN_USER=
ES_ADMIN_PASS=
ES_MEM_LIMIT=512m
KIBANA_SYSTEM_PASS=
KIBANA_PUBLIC_BASE_URL=
RABBITMQMONITORING_USER=
RABBITMQMONITORING_PASS=
 
# ==========================================
# TEAM FACTURATIE (FOSSBILLING)
# ==========================================
FOSSBILLING_DB_NAME=
FOSSBILLING_DB_USER=
FOSSBILLING_DB_PASS=
RABBITMQFACTURATIE_USER=
RABBITMQFACTURATIE_PASS=
 
# ==========================================
# TEAM KASSA (ODOO)
# ==========================================
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASS=
ODOO_MASTER_PASS=
RABBITMQKASSA_USER=
RABBITMQKASSA_PASS=
MCP_PORT=8004
MCP_EXTERNAL_PORT=30031
 
# ==========================================
# TEAM CRM
# ==========================================
RABBITMQCRM_USER=
RABBITMQCRM_PASS=
# Must be quoted if the password contains special chars like # or $
# Example: RABBITMQCRM_PASSRAW="your_password_here"
RABBITMQCRM_PASSRAW=
SF_INSTANCE_URL=
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_REFRESH_TOKEN=
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
 
# ==========================================
# TEAM PLANNING
# ==========================================
RABBITMQPLANNING_USER=
RABBITMQPLANNING_PASS=
 
# ==========================================
# IDENTITY SERVICE
# ==========================================
IDENTITY_RABBIT_USER=
IDENTITY_RABBIT_PASS=
 
# ==========================================
# RABBITMQ SHARED
# ==========================================
RABBIT_HOST=rabbitmq_broker
RABBIT_PORT=5672
RABBIT_VHOST=/
RABBIT_AUTO_SETUP_TOPOLOGY=
RABBIT_EXCHANGE=
RABBIT_INCOMING_QUEUE=
POLL_INTERVAL=
 
# ==========================================
# CLOUDFLARE TUNNEL
# ==========================================
CLOUDFLARE_TUNNEL_TOKEN=

# ==========================================
# CHATBOT
# ==========================================

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Sub-agent model (optional — falls back to NVIDIA_MODEL if not set)
# Use a faster/cheaper model for sub-agents; they only need to call tools and format output.
SUB_AGENT_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_SUBMODEL_KEY=

# ── PostgreSQL (shared infra DB) ──────────────────────────────────────────────
# In cluster: DB_HOST=postgredb-service (auto-set in chatbot.yaml)
# Local dev: use the external NodePort (see EXTERNAL_DB_PORT in infra .env)
DB_HOST=localhost
DB_PORT=30004
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── Admin auth ────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=
# Comma-separated email:password pairs. Leave empty to disable password check.
ADMIN_CREDENTIALS=
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
 
# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# Production shared broker (Azure):
RABBITMQ_HOST=integrationproject-2526s2-dag01.westeurope.cloudapp.azure.com
RABBITMQ_PORT=30000
RABBIT_USER=
RABBIT_PASS=
RABBITMQ_VHOST=/
# Local dev: RABBITMQ_HOST=localhost  RABBITMQ_PORT=5672
 
IDENTITY_RPC_QUEUE=identity.user.lookup.email.request
RPC_TIMEOUT=10.0
SESSION_TTL_SECONDS=3600
 
# ── MCP servers ───────────────────────────────────────────────────────────────
# sessions MCP removed — frontend MCP (port 8006) fully supersedes it.
# monitoring MCP (port 8005) is now the dedicated monitoring team server.
MCP_SERVERS=monitoring@http://localhost:8005/mcp,frontend@http://localhost:8006/mcp,facturatie@http://localhost:8007/mcp,crm@http://localhost:8008/mcp

# ── Frontend MCP → Drupal JSON:API ───────────────────────────────────────────
FRONTEND_BASE_URL=https://desiderius.me
# Optional basic-auth for Drupal admin-only JSON:API endpoints:
# DRUPAL_ADMIN_USER=admin
# DRUPAL_ADMIN_PASS=
 
# ── Monitoring MCP → Elasticsearch ───────────────────────────────────────────
# Real indices are date-based: logs-YYYY.MM.dd and heartbeats-YYYY.MM.dd
# Wildcards query across all dates automatically.
# TODO: replace with internal cluster DNS: kubectl get svc -n monitoring | grep elasticsearch
# External NodePort is 30060 (localhost only on the node)
ELASTICSEARCH_URL=http://localhost:9200
# ES auth (Elasticsearch 8 X-Pack — ask monitoring team for credentials):
# ES_USERNAME=elastic
# ES_PASSWORD=
ES_LOGS_INDEX=logs-*
ES_HEARTBEAT_INDEX=heartbeats-*