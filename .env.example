NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBIT_USER=guest
RABBIT_PASS=guest
RABBITMQ_VHOST=/

IDENTITY_RPC_QUEUE=identity.user.lookup.email.request

RPC_TIMEOUT=10.0
SESSION_TTL_SECONDS=3600

# MCP server URLs — comma-separated label@url pairs
# Each team runs their own MCP server; we run sessions and monitoring
MCP_SERVERS=sessions@http://localhost:8001/mcp,facturatie@http://localhost:8002/mcp,crm@http://localhost:8003/mcp,kassa@http://localhost:8004/mcp,monitoring@http://localhost:8005/mcp

# Sessions MCP server (our team — queries Drupal frontend)
FRONTEND_BASE_URL=http://localhost:30020

# Monitoring MCP server (our team — queries Elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200
ES_LOGS_INDEX=logs
ES_HEARTBEAT_INDEX=logs
