# NVIDIA LLM Configuration
# Get free API key from: https://integrate.api.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions

# RabbitMQ Connection
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBIT_USER=guest
RABBIT_PASS=guest
RABBITMQ_VHOST=/

# Downstream Service Queues
IDENTITY_RPC_QUEUE=identity.rpc
PLANNING_RPC_EXCHANGE=planning.exchange
FACTURATIE_RPC_QUEUE=facturatie.rpc
RPC_TIMEOUT=10.0
