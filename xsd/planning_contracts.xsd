<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <!-- ========================================
       PLANNING SERVICE CONTRACTS
       Used by: Chatbot MCP Server
       Queue: planning.exchange
       ======================================== -->

  <!-- ============ REQUEST: Sessions List ============ -->
  <xs:element name="sessions_list_request">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="master_uuid" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ============ RESPONSE: Sessions List ============ -->
  <xs:element name="sessions_list_response">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="status" type="xs:string"/>
        <xs:element name="error_code" type="xs:string" minOccurs="0"/>
        <xs:element name="message" type="xs:string" minOccurs="0"/>
        <xs:element name="session" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="session_id" type="xs:string"/>
              <xs:element name="name" type="xs:string"/>
              <xs:element name="date" type="xs:dateTime"/>
              <xs:element name="location" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ============ REQUEST: User Enrollments ============ -->
  <xs:element name="user_enrollments_request">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="master_uuid" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ============ RESPONSE: User Enrollments ============ -->
  <xs:element name="user_enrollments_response">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="status" type="xs:string"/>
        <xs:element name="error_code" type="xs:string" minOccurs="0"/>
        <xs:element name="message" type="xs:string" minOccurs="0"/>
        <xs:element name="session" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="session_id" type="xs:string"/>
              <xs:element name="name" type="xs:string"/>
              <xs:element name="date" type="xs:dateTime"/>
              <xs:element name="location" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ============ SHARED ERROR RESPONSE (optional) ============ -->
  <xs:element name="error_response">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="status" type="xs:string" fixed="error"/>
        <xs:element name="error_code" type="xs:string"/>
        <xs:element name="message" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
