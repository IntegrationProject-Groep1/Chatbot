<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <!-- ========================================
       FACTURATIE SERVICE CONTRACTS
       Used by: Chatbot MCP Server
       Queue: facturatie.rpc
       ======================================== -->

  <!-- ============ REQUEST: Invoices List ============ -->
  <xs:element name="invoices_list_request">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="master_uuid" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ============ RESPONSE: Invoices List ============ -->
  <xs:element name="invoices_list_response">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="status" type="xs:string"/>
        <xs:element name="error_code" type="xs:string" minOccurs="0"/>
        <xs:element name="message" type="xs:string" minOccurs="0"/>
        <xs:element name="invoice" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="invoice_id" type="xs:string"/>
              <xs:element name="amount" type="xs:decimal"/>
              <xs:element name="date" type="xs:dateTime"/>
              <xs:element name="status" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ============ REQUEST: Invoices Total ============ -->
  <xs:element name="invoices_total_request">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="master_uuid" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ============ RESPONSE: Invoices Total ============ -->
  <xs:element name="invoices_total_response">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="status" type="xs:string"/>
        <xs:element name="error_code" type="xs:string" minOccurs="0"/>
        <xs:element name="message" type="xs:string" minOccurs="0"/>
        <xs:element name="total_amount" type="xs:decimal"/>
        <xs:element name="currency" type="xs:string"/>
        <xs:element name="invoice_count" type="xs:integer"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ============ SHARED ERROR RESPONSE (optional) ============ -->
  <xs:element name="error_response">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="status" type="xs:string" fixed="error"/>
        <xs:element name="error_code" type="xs:string"/>
        <xs:element name="message" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
