<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <!-- ====================================================================
       CHATBOT MCP SERVER — XSD CONTRACTS v2.0
       
       This XSD defines the XML structure for all requests and responses
       used by the Chatbot MCP Server when communicating with downstream
       services (Planning, Facturatie) via RabbitMQ RPC.
       
       Conforms to Integration Project XML/XSD Contract v2.3:
       - All responses use standard <message><header><body> structure
       - UUID patterns, valuta, etc. follow the central contract
       - Error handling uses the global system_error format (§2.6)
       
       ===================================================================== -->

  <!-- ====== SHARED TYPES ====== -->

  <xs:simpleType name="UUIDType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CurrencyType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="eur"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="AmountType">
    <xs:simpleContent>
      <xs:extension base="xs:decimal">
        <xs:attribute name="currency" type="CurrencyType" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- ====== HEADER (Shared by all responses) ====== -->

  <xs:complexType name="HeaderType">
    <xs:sequence>
      <xs:element name="message_id" type="UUIDType"/>
      <xs:element name="timestamp" type="xs:dateTime"/>
      <xs:element name="source">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="chatbot"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="type" type="xs:string"/>
      <xs:element name="version">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="2.0"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="correlation_id" type="UUIDType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ====== PLANNING SERVICE REQUESTS ====== -->

  <!-- sessions_list_request: Request all available sessions -->
  <xs:element name="sessions_list_request">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="master_uuid" type="UUIDType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- user_enrollments_request: Request sessions user is enrolled in -->
  <xs:element name="user_enrollments_request">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="master_uuid" type="UUIDType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ====== PLANNING SERVICE RESPONSES ====== -->

  <!-- Session data structure (shared by both response types) -->
  <xs:complexType name="SessionType">
    <xs:sequence>
      <xs:element name="session_id" type="xs:string"/>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="date" type="xs:dateTime"/>
      <xs:element name="location" type="xs:string" minOccurs="0"/>
      <xs:element name="description" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- sessions_list_response: Response with all available sessions -->
  <xs:element name="message">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="header" type="HeaderType"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="status">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="ok"/>
                    <xs:enumeration value="error"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="session" type="SessionType" minOccurs="0" maxOccurs="unbounded"/>
              <!-- Error fields (only when status = error) -->
              <xs:element name="error_code" type="xs:string" minOccurs="0"/>
              <xs:element name="error_message" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ====== FACTURATIE SERVICE REQUESTS ====== -->

  <!-- invoices_list_request: Request all invoices for user -->
  <xs:element name="invoices_list_request">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="master_uuid" type="UUIDType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- invoices_total_request: Request total invoice amount -->
  <xs:element name="invoices_total_request">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="master_uuid" type="UUIDType"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ====== FACTURATIE SERVICE RESPONSES ====== -->

  <!-- Invoice data structure -->
  <xs:complexType name="InvoiceType">
    <xs:sequence>
      <xs:element name="invoice_id" type="xs:string"/>
      <xs:element name="amount" type="AmountType"/>
      <xs:element name="date" type="xs:date"/>
      <xs:element name="status">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:enumeration value="paid"/>
            <xs:enumeration value="pending"/>
            <xs:enumeration value="overdue"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="description" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <!-- invoices_list_response: Response with all invoices -->
  <xs:element name="invoices_list_response">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="header" type="HeaderType"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="status">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="ok"/>
                    <xs:enumeration value="error"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="invoice" type="InvoiceType" minOccurs="0" maxOccurs="unbounded"/>
              <!-- Error fields -->
              <xs:element name="error_code" type="xs:string" minOccurs="0"/>
              <xs:element name="error_message" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- invoices_total_response: Response with total amount -->
  <xs:element name="invoices_total_response">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="header" type="HeaderType"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="status">
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="ok"/>
                    <xs:enumeration value="error"/>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="total_amount" type="AmountType" minOccurs="0"/>
              <xs:element name="invoice_count" type="xs:nonNegativeInteger" minOccurs="0"/>
              <!-- Error fields -->
              <xs:element name="error_code" type="xs:string" minOccurs="0"/>
              <xs:element name="error_message" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- ====== ERROR RESPONSE (Global system_error per Contract §2.6) ====== -->

  <xs:element name="system_error">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="header" type="HeaderType"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="error_code" type="xs:string"/>
              <xs:element name="error_description" type="xs:string"/>
              <xs:element name="component" type="xs:string" minOccurs="0"/>
              <xs:element name="related_message_id" type="xs:string" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
